# RAG-Logger configuration template.
#   cp .env.example .env && chmod 600 .env     then fill in the values you need.
# .env is git-ignored; this example file is committed and must never contain real secrets.
# Variables already exported in your shell override values in .env.
# Syntax: KEY=value | KEY="quoted ${OTHER}" | KEY='literal' | # comments
# Blank values (KEY=) are ignored, so the built-in default applies.

# ---------------------------------------------------------------- LLM backends
# Default backend chain used by ask/chat (comma-separated fallback order):
# extractive | litellm | ollama | openai
# Switch to e.g. "litellm,ollama,extractive" once LITELLM_API_KEY and LITELLM_MODEL below are filled in.
RAGLOGGER_BACKEND=extractive

# LiteLLM gateway (Claude etc.). Base URL only, without /chat/completions.
LITELLM_BASE_URL=https://your-litellm-gateway.example.com
LITELLM_API_KEY=
# Exact model alias from: .venv/bin/python -m raglogger models
LITELLM_MODEL=
# Embedding alias on the gateway, only needed for RAGLOGGER_EMBEDDINGS=litellm
LITELLM_EMBEDDING_MODEL=
# Some gateway models (e.g. Claude Opus with extended thinking) only accept their default temperature.
# 'omit' = do not send temperature at all. Leave blank to inherit RAGLOGGER_TEMPERATURE.
LITELLM_TEMPERATURE=omit

# Local Ollama (data stays on this machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=

# Any other OpenAI-compatible endpoint (vLLM, LM Studio, OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=
RAGLOGGER_API_KEY=

# Generation parameters
# Optional: override model / endpoint of the FIRST backend in the chain (same as --model / --base-url)
RAGLOGGER_MODEL=
RAGLOGGER_BASE_URL=
# Default temperature for every backend: 0-2, or 'omit'. Per-backend *_TEMPERATURE above wins.
# If a backend still rejects the value, the request is retried once without temperature.
RAGLOGGER_TEMPERATURE=0.1
RAGLOGGER_MAX_TOKENS=2048
RAGLOGGER_TIMEOUT=120
RAGLOGGER_MAX_CONTEXT_CHARS=12000

# ---------------------------------------------------------------- Retrieval / vector DB
# Engine: auto (LangChain if installed) | langchain | native (stdlib, BM25 only)
RAGLOGGER_ENGINE=auto
# Embeddings: local (CPU, default) | litellm (gateway) | none (BM25 only)
RAGLOGGER_EMBEDDINGS=local
# Optional override, e.g. sentence-transformers/all-MiniLM-L6-v2
RAGLOGGER_EMBEDDING_MODEL=

# ---------------------------------------------------------------- Storage and logs
# All runtime data lives in RAGLOGGER_HOME (default: <project>/.raglogger, git-ignored).
# Leave the paths below blank to use their defaults inside RAGLOGGER_HOME.
# Relative paths are resolved against the project root, not the current directory.
RAGLOGGER_HOME=
# Default: ${RAGLOGGER_HOME}/index.json.gz
RAGLOGGER_INDEX=
# Default: <index name>-chroma next to the index
RAGLOGGER_VECTOR_DIR=
# Every LLM input context and output response (path or 'off'). Defaults: ${RAGLOGGER_HOME}/logs/...
RAGLOGGER_TRANSCRIPT_LOG=
RAGLOGGER_INTERACTION_LOG=

# Chroma telemetry (keep disabled for production log data)
ANONYMIZED_TELEMETRY=False
